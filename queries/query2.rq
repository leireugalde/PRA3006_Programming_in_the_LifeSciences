SELECT DISTINCT ?drug ?drugLabel ?condition ?conditionLabel WHERE {
  ?caffeine wdt:P662 "2519" .
  ?caffeine wdt:P129 ?receptor .
  FILTER(?receptor != wd:Q24770266)
  ?drug wdt:P129 ?receptor .
  FILTER(?drug != ?caffeine)
  ?drug wdt:P2175 ?condition .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?drugLabel